{
  "name": "destick",
  "version": "0.1.0",
  "private": true,
  "description": "One-click, reversible, 100% local MV3 extension that hides sticky/fixed/overlay junk and restores scrolling.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
